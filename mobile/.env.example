# Se usa con: flutter run --dart-define-from-file=.env
# (el Flutter SDK de este proyecto soporta nativamente archivos .env para
# --dart-define-from-file, no hace falta el paquete flutter_dotenv).
# Copiá este archivo a mobile/.env y completá los valores reales.
# NOTA: hasta que la Fase 4 del plan (conectar mobile al backend real) esté
# implementada, estas variables todavía no se leen en el código — quedan acá
# listas para que Fase 4 las consuma vía String.fromEnvironment(...).

# URL base de la API del backend Rails.
# - Simulador iOS / Chrome (flutter run -d chrome): http://localhost:3000/api/v1
# - Emulador Android: http://10.0.2.2:3000/api/v1
#   (en el emulador, "localhost" apunta al propio emulador, no a tu máquina)
API_BASE_URL=http://localhost:3000/api/v1

# Clave del proyecto de PostHog (para posthog_flutter, ya declarado en
# pubspec.yaml). Se consigue en tu cuenta de PostHog Cloud (https://posthog.com)
# → Project Settings → Project API Key. No se puede generar localmente, es
# específica de tu proyecto en PostHog.
POSTHOG_API_KEY=

# Host de PostHog Cloud, según la región de tu proyecto (mismo lugar que la
# API Key, en Project Settings):
# - Región US: https://us.i.posthog.com
# - Región EU: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
