# Copy this file to `.env` (already git-ignored, see .gitignore) and fill
# in real values. See ENV_SETUP.md for more detail on each variable.

# --- Database (PostgreSQL) --------------------------------------------------
# Matches docker-compose.yml's db service defaults — only change these if
# you're running Postgres outside docker-compose or with different
# credentials.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=fudo
POSTGRES_PASSWORD=fudo_password
POSTGRES_DB=fudo_consumers_development
# Only read in the test environment (config/database.yml) — the DB used by
# `bundle exec rspec` / `rails db:test:prepare`.
POSTGRES_TEST_DB=fudo_consumers_test
# ActiveRecord connection pool size (config/database.yml) — should be >=
# Puma's thread count below.
RAILS_MAX_THREADS=5

# --- JWT auth (app/lib/json_web_token.rb) -----------------------------------
# Dedicated secret for signing consumer auth tokens. Required in production
# (see config/initializers/jwt_secret_check.rb) — the app raises at boot if
# it's blank. In development/test it falls back to Rails' secret_key_base
# when unset, so it's optional locally.
# Generate one with: bin/rails secret
JWT_SECRET=replace-with-output-of-bin-rails-secret

# --- Lockbox / blind_index (config/initializers/lockbox.rb) -----------------
# Encrypts Consumer#dni at rest (Lockbox) and lets it still be looked up by
# an indexed blind index (BlindIndex). Both are required for any code path
# that touches Consumer#dni (including db/seeds.rb).
# Generate each with: bin/rails runner 'puts SecureRandom.hex(32)'
LOCKBOX_MASTER_KEY=replace-with-64-char-hex-secret
BLIND_INDEX_MASTER_KEY=replace-with-a-different-64-char-hex-secret

# --- Gemini API (app/services/search_query_parser.rb) -----------------------
# Powers the natural-language search parser (structured output). Get a key
# from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional — defaults to "gemini-flash-latest" if unset.
GEMINI_MODEL=gemini-flash-latest

# --- CORS (config/initializers/cors.rb) -------------------------------------
# Comma-separated list of allowed origins for cross-origin requests in
# production (e.g. the deployed web app's domain). In development, any
# localhost origin is already allowed regardless of this variable — see
# config/initializers/cors.rb.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Puma (config/puma.rb) ---------------------------------------------------
# Optional — defaults to 3000 if unset.
PORT=3000
# Optional — path to a pidfile; only used if set.
# PIDFILE=tmp/pids/server.pid

# --- Rails logging (config/environments/production.rb) ----------------------
# Optional — defaults to "info" in production if unset.
RAILS_LOG_LEVEL=info
