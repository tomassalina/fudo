# --- API del backend --------------------------------------------------------
# Ya referenciada en web/lib/api/client.ts. El prefijo NEXT_PUBLIC_ la expone
# también en el cliente (browser), no solo en el servidor — hace falta porque
# ese archivo no tiene un boundary de servidor.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# --- PostHog ------------------------------------------------------------------
# Analytics/feature flags client-side (posthog-js, todavía no agregado a
# package.json — se instala cuando se integre PostHog en la web). Necesita el
# prefijo NEXT_PUBLIC_ porque el SDK corre en el browser.
# Clave del proyecto: tu cuenta de PostHog Cloud (https://posthog.com) →
# Project Settings → Project API Key. No se puede generar localmente.
NEXT_PUBLIC_POSTHOG_KEY=

# Host según la región de tu proyecto PostHog Cloud (misma pantalla que la key):
# - Región US: https://us.i.posthog.com
# - Región EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- CARTO basemap tiles (mapa de /buscar) ------------------------------------
# CARTO's Dark Matter raster tiles (basemaps.cartocdn.com) now require a free
# API key — unauthenticated requests are served with an "API KEY REQUIRED"
# watermark instead of failing outright. Get one at https://carto.com/basemaps/apikey
# (free, no approval queue, key emailed immediately — 5M tile requests/month).
# Needs the NEXT_PUBLIC_ prefix because the map renders client-side.
NEXT_PUBLIC_CARTO_API_KEY=
